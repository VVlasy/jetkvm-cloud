diff --git a/test/token-refresh.test.ts b/test/token-refresh.test.ts
new file mode 100644
index 0000000..9d92478
--- /dev/null
+++ b/test/token-refresh.test.ts
@@ -0,0 +1,136 @@
+import * as jose from "jose";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+
+import {
+  ensureFreshIdToken,
+  openRefreshToken,
+  REFRESH_MARGIN_MS,
+  SESSION_ABSOLUTE_MAX_AGE_MS,
+  sealRefreshToken,
+  setRefresher,
+} from "../src/token-refresh";
+
+const secret = new TextEncoder().encode("test-signing-key-test-signing-key");
+
+async function idToken(expiresInMs: number, sub = "google-sub-1") {
+  const now = Date.now();
+  return new jose.SignJWT({ email: "user@example.com" })
+    .setProtectedHeader({ alg: "HS256" })
+    .setSubject(sub)
+    .setIssuedAt(Math.floor(now / 1000))
+    .setExpirationTime(Math.floor((now + expiresInMs) / 1000))
+    .sign(secret);
+}
+
+beforeAll(() => {
+  process.env.COOKIE_SECRET = "cookie-secret-for-tests";
+});
+
+afterEach(() => setRefresher(null));
+
+describe("sealRefreshToken / openRefreshToken", () => {
+  it("round-trips and does not leak the token", () => {
+    const sealed = sealRefreshToken("1//refresh-token");
+    expect(sealed).not.toContain("refresh-token");
+    expect(openRefreshToken(sealed)).toBe("1//refresh-token");
+  });
+
+  it("rejects tampered or foreign values", () => {
+    const sealed = sealRefreshToken("1//refresh-token");
+    const tampered = sealed.slice(0, -2) + (sealed.endsWith("A") ? "BB" : "AA");
+    expect(openRefreshToken(tampered)).toBeNull();
+    expect(openRefreshToken("not-sealed")).toBeNull();
+
+    process.env.COOKIE_SECRET = "another-secret";
+    expect(openRefreshToken(sealed)).toBeNull();
+    process.env.COOKIE_SECRET = "cookie-secret-for-tests";
+  });
+});
+
+describe("ensureFreshIdToken", () => {
+  it("leaves a token with plenty of time left alone", async () => {
+    const refresher = vi.fn();
+    setRefresher(refresher);
+    const session = { id_token: await idToken(30 * 60 * 1000), refresh_token_sealed: sealRefreshToken("rt") };
+
+    expect(await ensureFreshIdToken(session)).toBe(false);
+    expect(refresher).not.toHaveBeenCalled();
+  });
+
+  it("replaces an expired token using the stored refresh token", async () => {
+    const fresh = await idToken(60 * 60 * 1000);
+    const refresher = vi.fn().mockResolvedValue({ id_token: fresh });
+    setRefresher(refresher);
+    const session = {
+      id_token: await idToken(-10 * 60 * 1000),
+      refresh_token_sealed: sealRefreshToken("rt-1"),
+      authenticatedAt: Date.now() - 2 * 60 * 60 * 1000,
+    };
+
+    expect(await ensureFreshIdToken(session)).toBe(true);
+    expect(refresher).toHaveBeenCalledWith("rt-1");
+    expect(session.id_token).toBe(fresh);
+  });
+
+  it("refreshes inside the margin and stores a rotated refresh token", async () => {
+    setRefresher(async () => ({ id_token: await idToken(60 * 60 * 1000), refresh_token: "rt-2" }));
+    const session = {
+      id_token: await idToken(REFRESH_MARGIN_MS - 60 * 1000),
+      refresh_token_sealed: sealRefreshToken("rt-1"),
+    };
+
+    expect(await ensureFreshIdToken(session)).toBe(true);
+    expect(openRefreshToken(session.refresh_token_sealed)).toBe("rt-2");
+  });
+
+  it("shares one refresh between parallel requests", async () => {
+    const refresher = vi.fn(async () => ({ id_token: await idToken(60 * 60 * 1000) }));
+    setRefresher(refresher);
+    const expired = await idToken(-1000);
+    const sealed = sealRefreshToken("rt");
+    const a = { id_token: expired, refresh_token_sealed: sealed };
+    const b = { id_token: expired, refresh_token_sealed: sealed };
+
+    await Promise.all([ensureFreshIdToken(a), ensureFreshIdToken(b)]);
+    expect(refresher).toHaveBeenCalledTimes(1);
+    expect(a.id_token).toBe(b.id_token);
+  });
+
+  it("does nothing without a refresh token (sessions from before this change)", async () => {
+    const session = { id_token: await idToken(-1000) };
+    expect(await ensureFreshIdToken(session)).toBe(false);
+  });
+
+  it("stops refreshing after the absolute session lifetime", async () => {
+    const refresher = vi.fn();
+    setRefresher(refresher);
+    const session = {
+      id_token: await idToken(-1000),
+      refresh_token_sealed: sealRefreshToken("rt"),
+      authenticatedAt: Date.now() - SESSION_ABSOLUTE_MAX_AGE_MS - 1000,
+    };
+
+    expect(await ensureFreshIdToken(session)).toBe(false);
+    expect(refresher).not.toHaveBeenCalled();
+  });
+
+  it("keeps the old token when Google refuses the refresh", async () => {
+    setRefresher(async () => {
+      throw new Error("invalid_grant");
+    });
+    const expired = await idToken(-1000);
+    const session = { id_token: expired, refresh_token_sealed: sealRefreshToken("rt") };
+
+    expect(await ensureFreshIdToken(session)).toBe(false);
+    expect(session.id_token).toBe(expired);
+  });
+
+  it("ignores a refreshed token for another subject", async () => {
+    setRefresher(async () => ({ id_token: await idToken(60 * 60 * 1000, "someone-else") }));
+    const expired = await idToken(-1000);
+    const session = { id_token: expired, refresh_token_sealed: sealRefreshToken("rt") };
+
+    expect(await ensureFreshIdToken(session)).toBe(false);
+    expect(session.id_token).toBe(expired);
+  });
+});
