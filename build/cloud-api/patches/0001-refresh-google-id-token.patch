diff --git a/src/token-refresh.ts b/src/token-refresh.ts
new file mode 100644
index 0000000..2cea2e0
--- /dev/null
+++ b/src/token-refresh.ts
@@ -0,0 +1,156 @@
+import { createCipheriv, createDecipheriv, createHash, randomBytes } from "crypto";
+import type { NextFunction, Request, Response } from "express";
+import * as jose from "jose";
+import { Issuer, type BaseClient, type TokenSet } from "openid-client";
+
+/**
+ * Keeps the Google ID token in the session fresh.
+ *
+ * The session stores the Google ID token, and both this API (`authenticated`)
+ * and the device firmware (`authenticateSession` in jetkvm/kvm cloud.go)
+ * reject it once its `exp` has passed. Google issues ID tokens for one hour,
+ * so without a refresh every user was signed out, and could no longer open a
+ * KVM session, an hour after login.
+ *
+ * At sign-in we now ask Google for a refresh token (`access_type=offline`),
+ * keep it in the session cookie encrypted with a key derived from
+ * COOKIE_SECRET (cookie-session only signs, it does not encrypt), and swap in a
+ * new ID token shortly before the current one expires.
+ */
+
+/** Refresh when the ID token has less than this left. */
+export const REFRESH_MARGIN_MS = 5 * 60 * 1000;
+
+/** Stop refreshing this long after sign-in, forcing a fresh Google login. */
+export const SESSION_ABSOLUTE_MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;
+
+type Session = {
+  id_token?: string | null;
+  refresh_token_sealed?: string | null;
+  authenticatedAt?: number | null;
+} & Record<string, unknown>;
+
+const ALGORITHM = "aes-256-gcm";
+
+function encryptionKey(): Buffer {
+  const secret = process.env.COOKIE_SECRET;
+  if (!secret) throw new Error("COOKIE_SECRET is not set");
+  return createHash("sha256").update(`jetkvm-cloud/refresh-token:${secret}`).digest();
+}
+
+/** Encrypts a refresh token for storage in the session cookie. */
+export function sealRefreshToken(refreshToken: string): string {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv(ALGORITHM, encryptionKey(), iv);
+  const ciphertext = Buffer.concat([cipher.update(refreshToken, "utf8"), cipher.final()]);
+  return Buffer.concat([iv, cipher.getAuthTag(), ciphertext]).toString("base64url");
+}
+
+/** Decrypts a sealed refresh token; null if it is malformed or was sealed with another key. */
+export function openRefreshToken(sealed: string): string | null {
+  try {
+    const raw = Buffer.from(sealed, "base64url");
+    if (raw.length < 12 + 16 + 1) return null;
+    const decipher = createDecipheriv(ALGORITHM, encryptionKey(), raw.subarray(0, 12));
+    decipher.setAuthTag(raw.subarray(12, 28));
+    return Buffer.concat([decipher.update(raw.subarray(28)), decipher.final()]).toString("utf8");
+  } catch {
+    return null;
+  }
+}
+
+let clientPromise: Promise<BaseClient> | null = null;
+
+function googleClient(): Promise<BaseClient> {
+  clientPromise ??= Issuer.discover("https://accounts.google.com")
+    .then(
+      issuer =>
+        new issuer.Client({
+          client_id: process.env.GOOGLE_CLIENT_ID!,
+          client_secret: process.env.GOOGLE_CLIENT_SECRET,
+          response_types: ["code"],
+        }),
+    )
+    .catch(error => {
+      clientPromise = null; // retry discovery next time
+      throw error;
+    });
+  return clientPromise;
+}
+
+type Refresher = (refreshToken: string) => Promise<Pick<TokenSet, "id_token" | "refresh_token">>;
+
+let refresher: Refresher = async refreshToken => (await googleClient()).refresh(refreshToken);
+
+/** Test hook: replaces the call to Google's token endpoint. */
+export function setRefresher(fn: Refresher | null) {
+  refresher = fn ?? (async refreshToken => (await googleClient()).refresh(refreshToken));
+}
+
+// Parallel requests from one browser share a single refresh.
+const inFlight = new Map<string, ReturnType<Refresher>>();
+
+function needsRefresh(idToken: string, now: number): boolean {
+  try {
+    const { exp } = jose.decodeJwt(idToken);
+    return typeof exp !== "number" || exp * 1000 - now < REFRESH_MARGIN_MS;
+  } catch {
+    return false; // not a JWT; leave it for `authenticated` to reject
+  }
+}
+
+/**
+ * Replaces `session.id_token` with a fresh one when it is about to expire.
+ * Mutates the session object only; returns true when it did.
+ * Never throws: on failure the old token stays and normal auth decides.
+ */
+export async function ensureFreshIdToken(session: Session | null | undefined): Promise<boolean> {
+  const idToken = session?.id_token;
+  const sealed = session?.refresh_token_sealed;
+  if (!session || typeof idToken !== "string" || typeof sealed !== "string") return false;
+
+  const now = Date.now();
+  if (!needsRefresh(idToken, now)) return false;
+
+  const authenticatedAt = session.authenticatedAt;
+  if (typeof authenticatedAt === "number" && now - authenticatedAt > SESSION_ABSOLUTE_MAX_AGE_MS) {
+    return false;
+  }
+
+  const refreshToken = openRefreshToken(sealed);
+  if (!refreshToken) return false;
+
+  try {
+    let pending = inFlight.get(sealed);
+    if (!pending) {
+      pending = refresher(refreshToken).finally(() => inFlight.delete(sealed));
+      inFlight.set(sealed, pending);
+    }
+    const tokenSet = await pending;
+    if (!tokenSet.id_token) {
+      console.warn("[auth] Token refresh returned no ID token");
+      return false;
+    }
+
+    const previousSub = jose.decodeJwt(idToken).sub;
+    if (jose.decodeJwt(tokenSet.id_token).sub !== previousSub) {
+      console.warn("[auth] Token refresh returned a different subject; ignoring it");
+      return false;
+    }
+
+    session.id_token = tokenSet.id_token;
+    if (tokenSet.refresh_token && tokenSet.refresh_token !== refreshToken) {
+      session.refresh_token_sealed = sealRefreshToken(tokenSet.refresh_token);
+    }
+    return true;
+  } catch (error) {
+    console.warn("[auth] Token refresh failed:", (error as Error)?.message ?? error);
+    return false;
+  }
+}
+
+/** Express middleware: refresh the session's ID token before route handlers read it. */
+export const refreshSessionToken = async (req: Request, _res: Response, next: NextFunction) => {
+  await ensureFreshIdToken(req.session as Session | null | undefined);
+  next();
+};
